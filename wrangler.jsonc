{
  // Static assets only, no Worker script. Deploy: npx wrangler@4 deploy
  "name": "dicestats-oscarpurtell-com",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "routes": [
    // Cloudflare creates the DNS record and certificate. The deploy fails if the
    // hostname already has a DNS record — delete it first if one appears.
    { "pattern": "dicestats.oscarpurtell.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./"
  }
}
